import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Step 1: Load Dataset
df = pd.read_csv("customer_churn.csv")

# Step 2: Display Basic Information
print("First 5 Records:")
print(df.head())

print("\nDataset Shape:")
print(df.shape)

print("\nDataset Information:")
print(df.info())

# Step 3: Check Missing Values
print("\nMissing Values:")
print(df.isnull().sum())

# Step 4: Check Duplicate Records
print("\nDuplicate Records:", df.duplicated().sum())

# Step 5: Remove Duplicates
df.drop_duplicates(inplace=True)

# Step 6: Handle Missing Values
for col in df.select_dtypes(include=np.number).columns:
    df[col] = df[col].fillna(df[col].median())

for col in df.select_dtypes(include="object").columns:
    df[col] = df[col].fillna(df[col].mode()[0])

# Step 7: Convert TotalCharges to Numeric (if available)
if "TotalCharges" in df.columns:
    df["TotalCharges"] = pd.to_numeric(
        df["TotalCharges"], errors="coerce"
    )
    df["TotalCharges"] = df["TotalCharges"].fillna(
        df["TotalCharges"].median()
    )

# Step 8: Statistical Analysis
print("\nStatistical Summary:")
print(df.describe(include="all"))

# Step 9: Customer Churn Distribution
if "Churn" in df.columns:
    print("\nChurn Distribution:")
    print(df["Churn"].value_counts())

    sns.countplot(data=df, x="Churn")
    plt.title("Customer Churn Distribution")
    plt.show()

# Step 10: Numerical Data Correlation
numeric_df = df.select_dtypes(include=np.number)

plt.figure(figsize=(10, 6))
sns.heatmap(numeric_df.corr(), annot=True, cmap="coolwarm")
plt.title("Correlation Heatmap")
plt.show()

# Step 11: Monthly Charges Analysis
if "MonthlyCharges" in df.columns:
    sns.histplot(df["MonthlyCharges"], kde=True)
    plt.title("Monthly Charges Distribution")
    plt.show()

# Step 12: Tenure vs Churn
if "tenure" in df.columns and "Churn" in df.columns:
    sns.boxplot(data=df, x="Churn", y="tenure")
    plt.title("Tenure vs Customer Churn")
    plt.show()

# Step 13: Contract Type vs Churn
if "Contract" in df.columns and "Churn" in df.columns:
    sns.countplot(data=df, x="Contract", hue="Churn")
    plt.title("Contract Type vs Churn")
    plt.xticks(rotation=30)
    plt.show()

# Step 14: Save Cleaned Dataset
df.to_csv("cleaned_customer_churn.csv", index=False)

print("\nData Cleaning Completed Successfully!")
print("Cleaned Dataset Saved Successfully.")
